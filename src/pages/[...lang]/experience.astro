---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ExperienceItem from "../../components/ui/ExperienceItem.astro";
import CourseItem from "../../components/ui/CourseItem.astro";
import Heading from "../../components/ui/Heading.astro";
import { getSortedCollection } from "../../lib/content";
import { getLangStaticPaths, localizePath, useI18n } from "../../i18n/utils";

export const getStaticPaths = getLangStaticPaths;

const { lang, t } = useI18n(Astro.currentLocale);

const [experience, leadership, courses] = await Promise.all([
  getSortedCollection("experience"),
  getSortedCollection("leadership"),
  getSortedCollection("courses"),
]);
---

<Layout
  title={t("page.experience.title")}
  description={t("page.experience.description")}
>
  <main class="experience-page">
    <div class="container experience-page-content">
      <PageHeader
        backHref={localizePath("/#experience", lang)}
        title={t("experience.title")}
      />
      <ul class="experience-list">
        {
          experience.map((entry, i) => (
            <ExperienceItem entry={entry} index={i} delayStep={80} />
          ))
        }
      </ul>

      <section
        class="experience-subsection"
        aria-labelledby="leadership-heading"
      >
        <Heading as="h2" id="leadership-heading">
          {t("experience.leadership")}
        </Heading>
        <ul class="experience-list">
          {
            leadership.map((entry, i) => (
              <ExperienceItem entry={entry} index={i} delayStep={80} />
            ))
          }
        </ul>
      </section>

      <section class="experience-subsection" aria-labelledby="courses-heading">
        <Heading as="h2" id="courses-heading">{t("experience.courses")}</Heading
        >
        <ul class="experience-list">
          {
            courses.map((course, i) => (
              <CourseItem course={course.data} index={i} delayStep={80} />
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style>
  .experience-page {
    min-height: 100dvh;
    padding-top: 100px;
    padding-bottom: 80px;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .experience-subsection {
    margin-top: 80px;
  }

  @media screen and (width <= 768px) {
    .experience-subsection {
      margin-top: 56px;
    }
  }
</style>
