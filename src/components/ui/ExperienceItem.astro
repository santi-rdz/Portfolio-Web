---
import Heading from "./Heading.astro";
import type { CollectionEntry } from "astro:content";
import { localize, localizePath, useI18n } from "../../i18n/utils";

interface Props {
  entry: CollectionEntry<"experience"> | CollectionEntry<"leadership">;
  index: number;
  delayStep?: number;
  slice?: number;
}

const { entry, index, slice, delayStep = 100 } = Astro.props;
const { lang, t } = useI18n(Astro.currentLocale);

const { data } = entry;
const title = localize(data.title, lang);
const organization = localize(data.organization, lang);
const details = localize(data.details, lang);
const duration = "duration" in data ? data.duration?.[lang] : undefined;
const date = "date" in data ? data.date[lang] : undefined;

const visibleDetails = slice ? details.slice(0, slice) : details;
const remaining = slice ? Math.max(0, details.length - slice) : 0;
---

<li
  class="experience-item timeline-item"
  data-animate="fade-up"
  style={`--delay: ${index * delayStep}ms`}
  transition:name={`experience-${entry.id}`}
>
  <header class="experience-item--header timeline-marker">
    <div>
      <Heading as="h3">{title}</Heading>
      {
        duration && (
          <span class="experience-duration">
            {t("experience.duration")} {duration}
          </span>
        )
      }
      {date && <span class="experience-duration">{date}</span>}
    </div>
    <span class="experience-source">{organization}</span>
  </header>
  <ul class="experience-details">
    {
      visibleDetails.map((detail) => (
        <li class="experience-detail">{detail}</li>
      ))
    }
    {
      remaining > 0 && (
        <li class="experience-more-item">
          <a href={localizePath("/experience", lang)} class="experience-more">
            {t("experience.moreDetails")} +{remaining}
          </a>
        </li>
      )
    }
  </ul>
</li>

<style>
  .experience-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 24px;
  }

  .experience-item--header {
    padding-left: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .experience-source {
    font-size: var(--font-7);
    color: var(--color-primary);
    font-family: "JetBrains";
  }

  .experience-duration {
    font-size: var(--font-7);
    color: var(--color-gray);
  }

  .experience-details {
    display: flex;
    flex-direction: column;
    line-height: 1.5;
    font-size: var(--font-6);
    color: var(--color-gray);
    padding-left: 24px;
  }

  .experience-detail {
    text-wrap: balance;
  }

  .experience-details li:not(.experience-more-item)::before {
    content: "•";
    color: var(--color-primary);
    display: inline-block;
    width: 1ch;
  }

  @media screen and (width <= 768px) {
    .experience-item--header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }

  @media screen and (width <= 480px) {
    .experience-item {
      padding: 16px;
    }
  }
</style>
