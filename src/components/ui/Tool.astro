---
import TechIcon from "../icons/TechIcon.astro";

const { name, "data-md": md, "data-sm": sm, "data-square": square } = Astro.props;

const size = sm !== undefined ? 14 : md !== undefined ? 10 : 14;
---

<span
  class="tool-item txt-7"
  data-md={md !== undefined ? "" : undefined}
  data-sm={sm !== undefined ? "" : undefined}
  data-square={square !== undefined ? "" : undefined}
>
  <TechIcon name={name} size={size} />
  {name}
</span>

<style>
  .tool-item {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background-color: #fff;
    color: var(--color-heading);
    border: 1px solid transparent;
    box-shadow: inset 0 0 0 1px var(--lines-grid-color);
    font-family: "JetBrains";
    cursor: default;
    white-space: nowrap;
    transform: translateZ(0);
    will-change: transform;
    transition:
      color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .tool-item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-primary);
    box-shadow: 0 10px 22px -18px var(--color-primary);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .tool-item:hover {
    color: #fff;
    transform: translateY(-1px);
  }
  .tool-item:hover::before {
    opacity: 1;
  }
  .tool-item :global(.tech-icon) {
    transition: filter 0.18s ease;
  }
  .tool-item:hover :global(.tech-icon),
  .tool-item:focus-visible :global(.tech-icon) {
    filter: brightness(0) invert(1);
  }
  .tool-item[data-md] {
    min-height: 24px;
    padding: 3px 8px;
    font-size: 0.65rem;
    gap: 4px;
  }
  .tool-item[data-sm] {
    min-height: 31px;
    padding: 5px 12px;
    font-size: 0.75rem;
    gap: 5px;
  }
  .tool-item[data-square] {
    border-radius: var(--radius-md);
  }
</style>
