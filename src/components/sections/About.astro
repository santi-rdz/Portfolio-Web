---
import Heading from "../ui/Heading.astro";
import RichText from "../ui/RichText.astro";
import { featuredTechs } from "../../data/site";
import { useI18n } from "../../i18n/utils";
import type { UIKey } from "../../i18n/ui";

const { t } = useI18n(Astro.currentLocale);

const paragraphs: UIKey[] = ["about.intro", "about.cais", "about.cimarket"];
---

<section id="about" class="about-section center-section">
  <div class="container">
    <header>
      <Heading as="h2">{t("about.title")}</Heading>
    </header>
    <div class="about-grid">
      <section class="about-text txt-6">
        {
          paragraphs.map((key, i) => (
            <p data-animate="fade-up" style={`--delay: ${(i + 1) * 100}ms`}>
              <RichText text={t(key)} highlightClass="about-highlight" />
            </p>
          ))
        }
      </section>
      <section class="about-techs" data-animate="fade-left">
        <div>
          <p class="txt-6">{t("about.techsTitle")}</p>
          <ul class="techs-list">
            {featuredTechs.map((tech) => <li>{tech}</li>)}
          </ul>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: flex;
    gap: 120px;
  }

  .about-text {
    flex-basis: 55%;
    text-align: justify;
    display: flex;
    flex-direction: column;
    gap: 1lh;
  }

  .about-text p {
    color: var(--color-gray);
  }

  .about-text :global(.about-highlight) {
    color: var(--color-primary);
    font-weight: var(--font-medium);
  }

  .about-techs {
    border: 1px solid var(--color-primary-20);
    flex-basis: 45%;
    border-radius: var(--radius-md);
  }

  .about-techs div {
    padding: 16px;
    border: 1px solid var(--lines-grid-color);
    transform: translate(-6px, -6px);
    background-color: #fff;
    border-radius: inherit;
    box-shadow:
      0px 1px 3px rgba(0, 0, 0, 0.1),
      0px 1px 2px -1px rgba(0, 0, 0, 0.1);
  }

  .about-techs p {
    color: var(--color-gray);
    font-weight: var(--font-regular);
  }

  .techs-list {
    margin-top: 16px;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    color: var(--color-gray);
    font-family: "JetBrains";
    font-weight: var(--font-regular);
  }

  .techs-list li::before {
    content: ">";
    color: var(--color-primary);
    margin-right: 4px;
  }

  @media screen and (width <= 900px) {
    .about-grid {
      flex-direction: column;
      gap: 32px;
    }

    .about-text,
    .about-techs {
      flex-basis: auto;
    }

    .about-techs {
      max-width: 480px;
    }
  }

  @media screen and (width <= 480px) {
    .about-grid {
      gap: 24px;
    }

    .techs-list {
      grid-template-columns: 1fr;
    }

    .about-techs {
      max-width: 100%;
    }
  }
</style>
