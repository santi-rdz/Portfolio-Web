---
import Heading from "../ui/Heading.astro";
import ExperienceItem from "../ui/ExperienceItem.astro";
import ViewAllLink from "../ui/ViewAllLink.astro";
import { getSortedCollection } from "../../lib/content";
import { localizePath, useI18n } from "../../i18n/utils";

const { lang, t } = useI18n(Astro.currentLocale);
const preview = (await getSortedCollection("experience")).slice(0, 3);
---

<section id="experience" class="experience-section center-section">
  <div class="experience-content container">
    <Heading as="h2">{t("experience.title")}</Heading>
    <ul class="experience-list">
      {
        preview.map((entry, i) => (
          <ExperienceItem entry={entry} index={i} slice={3} />
        ))
      }
    </ul>
    <ViewAllLink href={localizePath("/experience", lang)}
      >{t("common.viewAll")} &rarr;</ViewAllLink
    >
  </div>
</section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
  }

  @media screen and (width <= 480px) {
    .experience-list :nth-child(3) {
      display: none;
    }
  }
</style>
