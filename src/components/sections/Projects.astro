---
import Heading from "../ui/Heading.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import ViewAllLink from "../ui/ViewAllLink.astro";
import { getSortedCollection } from "../../lib/content";
import { localizePath, useI18n } from "../../i18n/utils";

const { lang, t } = useI18n(Astro.currentLocale);

const preview = (await getSortedCollection("projects")).slice(0, 3);
---

<section id="projects" class="projects-scetion center-section">
  <div class="container">
    <Heading as="h2" transition:name="projects-heading"
      >{t("projects.title")}</Heading
    >
    <ul class="project-list">
      {
        preview.map((project, i) => (
          <ProjectCard project={project.data} index={i} maxTools={4} />
        ))
      }
    </ul>
    <ViewAllLink href={localizePath("/projects", lang)}
      >{t("common.viewAll")} &rarr;</ViewAllLink
    >
  </div>
</section>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media screen and (width <= 768px) {
    .project-list {
      gap: 1.25rem;
    }
  }

  @media screen and (width <= 480px) {
    .project-list :nth-child(3) {
      display: none;
    }
  }
</style>
