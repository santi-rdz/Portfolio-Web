---
import Heading from "../ui/Heading.astro";
import Link from "../ui/Link.astro";
import { localizePath, useI18n } from "../../i18n/utils";

const { lang, t } = useI18n(Astro.currentLocale);
---

<section id="contact" class="contact-section center-section">
  <div class="contact-container container">
    <header class="contact-header" data-animate="fade-up">
      <Heading as="h4">{t("contact.kicker")}</Heading>
      <Heading as="h2">{t("contact.title")}</Heading>
      <p class="contact-description">
        {t("contact.description")}
      </p>
    </header>
    <form
      name="contact"
      method="POST"
      action={localizePath("/success", lang)}
      data-netlify="true"
      class="contact-form"
      data-animate="fade-up"
      style="--delay: 150ms"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input
        class="input"
        type="text"
        name="name"
        placeholder={t("contact.name")}
        aria-label={t("contact.name")}
        autocomplete="name"
        required
      />
      <input
        class="input"
        type="email"
        name="email"
        placeholder={t("contact.email")}
        aria-label={t("contact.email")}
        autocomplete="email"
        required
      />
      <textarea
        class="input"
        name="message"
        rows="5"
        placeholder={t("contact.message")}
        aria-label={t("contact.message")}
        required></textarea>
      <Link type="submit" data-md as="button" data-mono data-cta
        >{t("contact.submit")}</Link
      >
    </form>
  </div>
</section>

<style>
  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }
  .contact-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .contact-description {
    color: var(--color-gray);
    max-width: 300px;
    font-size: var(--font-6);
    font-weight: var(--font-regular);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    width: 100%;
    max-width: 400px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
    font-size: var(--font-6);
    color: var(--color-gray);

    span {
      font-family: "JetBrains";
      font-size: var(--font-7);
    }
  }
  .input {
    border: 1px solid var(--lines-grid-color);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-family: "JetBrains";
    resize: none;
    &::placeholder {
      color: var(--color-gray-50);
    }
  }

  @media screen and (width <= 768px) {
    .contact-container {
      gap: 32px;
    }

    .contact-form {
      max-width: 100%;
    }
  }

  @media screen and (width <= 480px) {
    .contact-container {
      gap: 24px;
    }
  }
</style>
