---
import Heading from "../ui/Heading.astro";
import TechIcon from "../icons/TechIcon.astro";
import { skillGroups, type Skill } from "../../data/skills";
import { useI18n } from "../../i18n/utils";

const { t } = useI18n(Astro.currentLocale);

const toChip = (skill: Skill) =>
  typeof skill === "string"
    ? { icon: skill, label: skill }
    : { icon: skill.icon, label: t(skill.labelKey) };
---

<section id="skills" class="skills-section center-section">
  <div class="container">
    <Heading as="h2">{t("skills.title")}</Heading>
    <div class="skills-content">
      {
        skillGroups.map((group) => (
          <section class="skill-group">
            <Heading as="h4">{t(group.titleKey)}</Heading>
            <ul class="tools-list list">
              {group.items.map(toChip).map(({ icon, label }) => (
                <li class="tool-item">
                  <TechIcon name={icon} />
                  {label}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .tool-item {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 39px;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    cursor: default;
    white-space: nowrap;
    transform: translateZ(0);
    will-change: transform;
    transition:
      color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .tool-item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .tool-item {
    background-color: var(--color-primary-5);
    box-shadow: inset 0 0 0 1px var(--color-primary-20);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .tool-item::before {
    background-color: var(--color-primary);
    box-shadow: 0 12px 26px -18px var(--color-primary);
  }

  .tool-item:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .tool-item:hover::before {
    opacity: 1;
  }

  .tool-item :global(.tech-icon) {
    transition: filter 0.18s ease;
  }

  .tool-item:hover :global(.tech-icon),
  .tool-item:focus-visible :global(.tech-icon) {
    filter: brightness(0) invert(1);
  }

  @media screen and (width <= 900px) {
    .skills-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media screen and (width <= 480px) {
    .tool-item {
      font-size: var(--font-7);
      min-height: 35px;
      padding: 0.375rem 0.75rem;
      white-space: normal;
    }
  }
</style>
