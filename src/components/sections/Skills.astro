---
import Heading from "../ui/Heading.astro";
import TechIcon from "../icons/TechIcon.astro";

const skills = [
  "Frontend Development",
  "Backend Development",
  "Responsive Design",
  "JavaScript (ES6+)",
  "TypeScript",
  "Component-Based Frameworks (React, Astro)",
  "CSS (Tailwind CSS, Flexbox, Grid)",
  "Semantic HTML",
  "CSS Architecture",
  "RESTful APIs",
  "Authentication and Security",
  "Database Integration",
  "End-to-End Testing",
  "Accessibility (a11y)",
  "Performance Optimization",
];
const tools = [
  "HTML5",
  "CSS3",
  "JavaScript",
  "TypeScript",
  "React",
  "Astro",
  "Node.js",
  "Express",
  "Tailwind CSS",
  "Git",
  "GitHub",
  "VS Code",
  "Zod",
  "Prisma",
  "MySQL",
  "Selenium",
  "Supabase",
  "Vercel",
  "Figma",
];
---

<section id="skills" class="skills-section center-section">
  <div class="container">
    <Heading as="h2">Skills & Tools</Heading>
    <div class="skills-content">
      <section class="skills">
        <Heading as="h4">Skills</Heading>
        <ul class="skills-list list">
          {skills.map((skill) => <li class="skill-item">{skill}</li>)}
        </ul>
      </section>
      <section class="tools">
        <Heading as="h4">Tools</Heading>
        <ul class="tools-list list">
          {
            tools.map((tool) => (
              <li class="tool-item">
                <TechIcon name={tool} />
                {tool}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .skills-content {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .skill-item,
  .tool-item {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 39px;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    cursor: default;
    white-space: nowrap;
    transform: translateZ(0);
    will-change: transform;
    transition:
      color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .skill-item::before,
  .tool-item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .skill-item {
    background-color: #f1f5f9;
    box-shadow: inset 0 0 0 1px var(--lines-grid-color);
    color: var(--color-gray);
    font-weight: var(--font-medium);
  }

  .skill-item::before {
    background-color: #fff;
    box-shadow:
      inset 0 0 0 1px var(--color-primary-20),
      0 10px 24px -18px var(--color-primary);
  }

  .skill-item:hover {
    color: var(--color-heading);
    transform: translateY(-1px);
  }

  .skill-item:hover::before {
    opacity: 1;
  }

  .tool-item {
    background-color: var(--color-primary-5);
    box-shadow: inset 0 0 0 1px var(--color-primary-20);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .tool-item::before {
    background-color: var(--color-primary);
    box-shadow: 0 12px 26px -18px var(--color-primary);
  }

  .tool-item:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .tool-item:hover::before {
    opacity: 1;
  }

  .tool-item :global(.tech-icon) {
    transition: filter 0.18s ease;
  }

  .tool-item:hover :global(.tech-icon),
  .tool-item:focus-visible :global(.tech-icon) {
    filter: brightness(0) invert(1);
  }

  @media screen and (width <= 900px) {
    .skills-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media screen and (width <= 480px) {
    .skill-item,
    .tool-item {
      font-size: var(--font-7);
      min-height: 35px;
      padding: 0.375rem 0.75rem;
      white-space: normal;
    }
  }
</style>
